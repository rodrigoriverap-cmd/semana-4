public class BaseStats
{
    public float health;
    public float maxHealth;
    public float damage;
    public float speed;

    public BaseStats(float health, float maxHealth, float damage, float speed)
    {
        this.health = health;
        this.maxHealth = maxHealth;
        this.damage = damage;
        this.speed = speed;
    }

    public void ReceiveDamage(float amount)
    {
        health -= amount;
        if (health < 0) health = 0;
    }

    public void Heal(float amount)
    {
        health += amount;
        if (health > maxHealth) health = maxHealth;
    }
}
