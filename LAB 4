using UnityEngine;
public class EnemyBase : Entity
{
public ElementType afinidadElemental =
ElementType.Fisico;
public float resistenciaElemental = 0;
public float dañoContacto = 10;
protected virtual void Awake()
{
stats = new BaseStats(
50,
50,
10,
2
);
}
public override void TakeDamage(
float cantidad,
ElementType elemento
)
{
float dañoFinal = cantidad;
if (elemento == afinidadElemental)
{
dañoFinal =
cantidad * (1f - resistenciaElemental);
}
stats.RecibirDaño(dañoFinal);
Debug.Log(
gameObject.name +
" recibió " +
dañoFinal +
" de daño."
);
if (Vida <= 0)
{
Morir();
}
}
protected virtual void Morir()
{
SoltarExperiencia();
Destroy(gameObject);
}
void SoltarExperiencia()
{
GameObject xp =
new GameObject("XP");
xp.transform.position =
transform.position;
XPOrb esfera =
xp.AddComponent<XPOrb>();
esfera.valorExperiencia = 10;
}
void OnCollisionEnter2D(Collision2D collision)
{
Player jugador =
collision.gameObject.GetComponent<Player>();
if (jugador != null)
{
jugador.TakeDamage(
dañoContacto,
ElementType.Fisico
);
}
}
}




using UnityEngine;
public class Player : Entity
{
[Header("Movimiento")]
public float velocidadMovimiento = 5;
[Header("Ataque automático")]
public float intervaloAtaque = 1;
public float rangoAtaque = 3;
[Header("Elemento")]
public ElementType elementoAtaque = ElementType.Fuego;
[Header("Experiencia")]
public float experiencia = 0;
private float contadorAtaque = 0;
private bool muerto = false;
protected virtual void Awake()
{
stats = new BaseStats(
100,
100,
25,
velocidadMovimiento
);
}
void Update()
{
if (muerto)
{
return;
}
Mover();
AtaqueAutomatico();
}
void Mover()
{
float horizontal = 0;
float vertical = 0;
if (Input.GetKey(KeyCode.W))
{
vertical += 1;
}
if (Input.GetKey(KeyCode.S))
{
vertical -= 1;
}
if (Input.GetKey(KeyCode.A))
{
horizontal -= 1;
}
if (Input.GetKey(KeyCode.D))
{
horizontal += 1;
}
Vector3 movimiento = new Vector3(
horizontal,
vertical,
0f
);
if (movimiento != Vector3.zero)
{
movimiento = movimiento.normalized;
}
transform.position +=
movimiento *
velocidadMovimiento *
Time.deltaTime;
}
void AtaqueAutomatico()
{
contadorAtaque -= Time.deltaTime;
if (contadorAtaque > 0)
{
return;
}
contadorAtaque = intervaloAtaque;
Collider2D[] objetosDetectados =
Physics2D.OverlapCircleAll(
transform.position,
rangoAtaque
);
foreach (Collider2D objeto in objetosDetectados)
{
EnemyBase enemigo =
objeto.GetComponent<EnemyBase>();
if (enemigo != null)
{
enemigo.TakeDamage(
Daño,
elementoAtaque
);
Debug.Log(
"Player atacó a " +
enemigo.gameObject.name +
" con " +
elementoAtaque
);
break;
}
}
}
public override void TakeDamage(
float cantidad,
ElementType elemento
)
{
if (muerto)
{
return;
}
stats.RecibirDaño(cantidad);
Debug.Log(
"Player recibió " +
cantidad +
" de daño."
);
if (Vida <= 0)
{
Morir();
}
}
public void GanarExperiencia(float cantidad)
{
experiencia += cantidad;
Debug.Log(
"Experiencia actual: " +
experiencia
);
}
public void CurarJugador(float cantidad)
{
if (muerto)
{
return;
}
Curar(cantidad);
Debug.Log(
"Player recuperó " +
cantidad +
" de vida."
);
}
void Morir()
{
muerto = true;
Debug.Log("GAME OVER");
}
public bool EstaMuerto()
{
return muerto;
}
void OnDrawGizmosSelected()
{
Gizmos.DrawWireSphere(
transform.position,
rangoAtaque
);
}
}





