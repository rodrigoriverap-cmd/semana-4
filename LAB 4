public class BaseStats
{
public float vida;
public float vidaMaxima;
public float daño;
public float velocidad;
public BaseStats(
float vida,
float vidaMaxima,
float daño,
float velocidad)
{
this.vida = vida;
this.vidaMaxima = vidaMaxima;
this.daño = daño;
this.velocidad = velocidad;
}
public void RecibirDaño(float cantidad)
{
vida -= cantidad;
if (vida < 0)
{
vida = 0;
}
}
public void Curar(float cantidad)
{
vida += cantidad;
if (vida > vidaMaxima)
{
vida = vidaMaxima;
}
}
}
