using UnityEngine;
public class EnemySpawner : MonoBehaviour
{
public GameObject[] enemigos;
public float intervalo = 2;
public int cantidadMaxima = 20;
private float contador = 0;
void Update()
{
contador += Time.deltaTime;
if (contador >= intervalo)
{
contador = 0;
GenerarEnemigo();
}
}
void GenerarEnemigo()
{
if (enemigos.Length == 0)
{
return;
}
EnemyBase[] enemigosActuales =
FindObjectsByType<EnemyBase>(
FindObjectsSortMode.None
);
if (enemigosActuales.Length >= cantidadMaxima)
{
return;
}
int indice =
Random.Range(
0,
enemigos.Length
);
Vector2 posicion =
Random.insideUnitCircle * 6;
Instantiate(
enemigos[indice],
transform.position +
new Vector3(
posicion.x,
posicion.y,
0
),
Quaternion.identity
);
}
}
