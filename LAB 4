using UnityEngine;

public class EnemyMelee : EnemyBase
{
    private Player player;

    protected override void Awake()
    {
        base.Awake();
        stats = new BaseStats(50, 50, 10, 2f);
        elementalAffinity = ElementType.Physical;
        elementalResistance = 0;
        contactDamage = 10;
    }

    void Start()
    {
        player = FindFirstObjectByType<Player>();
    }

    void Update()
    {
        if (player == null) return;
        MoveTowardPlayer();
    }

    void MoveTowardPlayer()
    {
        Vector3 dir = player.transform.position - transform.position;

        if (dir != Vector3.zero)
            dir.Normalize();

        transform.position += dir * Speed * Time.deltaTime;
    }
}






using UnityEngine;

public class EnemyBase : Entity
{
    public ElementType elementalAffinity = ElementType.Physical;
    public float elementalResistance = 0;
    public float contactDamage = 10;

    protected virtual void Awake()
    {
        stats = new BaseStats(50, 50, 10, 2);
    }

    public override void TakeDamage(float amount, ElementType element)
    {
        float finalDamage = amount;

        if (element == elementalAffinity)
        {
            finalDamage = amount * (1f - elementalResistance);
        }

        stats.ReceiveDamage(finalDamage);

        Debug.Log(gameObject.name + " received " + finalDamage + " damage.");

        if (Health <= 0)
        {
            Die();
        }
    }

    protected virtual void Die()
    {
        DropExperience();
        Destroy(gameObject);
    }

    void DropExperience()
    {
        GameObject xp = new GameObject("XP");
        xp.transform.position = transform.position;

        XPOrb orb = xp.AddComponent<XPOrb>();
        orb.xpValue = 10;
    }

    void OnCollisionEnter2D(Collision2D collision)
    {
        Player player = collision.gameObject.GetComponent<Player>();

        if (player != null)
        {
            player.TakeDamage(contactDamage, ElementType.Physical);
        }
    }
}






using UnityEngine;

public class Player : Entity
{
    [Header("Movement")]
    public float moveSpeed = 5;

    [Header("Auto Attack")]
    public float attackInterval = 1;
    public float attackRange = 3;

    [Header("Element")]
    public ElementType attackElement = ElementType.Fire;

    [Header("Experience")]
    public float experience = 0;

    private float attackCounter = 0;
    private bool dead = false;

    protected virtual void Awake()
    {
        stats = new BaseStats(100, 100, 25, moveSpeed);
    }

    void Update()
    {
        if (dead) return;

        Move();
        AutoAttack();
    }

    void Move()
    {
        float h = 0;
        float v = 0;

        if (Input.GetKey(KeyCode.W)) v += 1;
        if (Input.GetKey(KeyCode.S)) v -= 1;
        if (Input.GetKey(KeyCode.A)) h -= 1;
        if (Input.GetKey(KeyCode.D)) h += 1;

        Vector3 movement = new Vector3(h, v, 0);

        if (movement != Vector3.zero)
            movement.Normalize();

        transform.position += movement * moveSpeed * Time.deltaTime;
    }

    void AutoAttack()
    {
        attackCounter -= Time.deltaTime;
        if (attackCounter > 0) return;

        attackCounter = attackInterval;

        Collider2D[] detected =
            Physics2D.OverlapCircleAll(transform.position, attackRange);

        foreach (Collider2D obj in detected)
        {
            EnemyBase enemy = obj.GetComponent<EnemyBase>();

            if (enemy != null)
            {
                enemy.TakeDamage(Damage, attackElement);
                Debug.Log("Player attacked " + enemy.gameObject.name + " with " + attackElement);
                break;
            }
        }
    }

    public override void TakeDamage(float amount, ElementType element)
    {
        if (dead) return;

        stats.ReceiveDamage(amount);
        Debug.Log("Player received " + amount + " damage.");

        if (Health <= 0)
        {
            Die();
        }
    }

    public void GainExperience(float amount)
    {
        experience += amount;
        Debug.Log("Current XP: " + experience);
    }

    public void HealPlayer(float amount)
    {
        if (dead) return;

        Heal(amount);
        Debug.Log("Player recovered " + amount + " health.");
    }

    void Die()
    {
        dead = true;
        Debug.Log("GAME OVER");
    }

    public bool IsDead()
    {
        return dead;
    }

    void OnDrawGizmosSelected()
    {
        Gizmos.DrawWireSphere(transform.position, attackRange);
    }
}




